# ── Runway Environment Variables ──────────────────────────────────────────────

# Server
PORT=3001                        # Backend port (Railway sets this automatically)

# Infrastructure mode
# 'local'  → uses MockCloud (http://localhost:4566) as AWS backend, no real AWS needed
# 'aws'    → uses real AWS, requires credentials below
INFRA_MODE=local

# AWS (only required when INFRA_MODE=aws)
AWS_ACCESS_KEY_ID=               # Your AWS access key
AWS_SECRET_ACCESS_KEY=           # Your AWS secret key
AWS_REGION=us-east-1             # Target AWS region

# MockCloud endpoint (only used when INFRA_MODE=local)
# Point this at your running MockCloud instance
MOCKCLOUD_ENDPOINT=http://localhost:4566

# Frontend (Vite — set in frontend/.env)
# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=ws://localhost:3001
